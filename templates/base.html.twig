<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport"    content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Integration du template Progressus dans Symfony 7">
	<meta name="author"      content="IPlkt |">

	<title>	{% block title %} IPlkt  {% endblock %} </title>

	{% block stylesheets %}
		<link rel="shortcut icon" href="{{ asset('assets/images/gt_favicon.png') }}">
		<link rel="stylesheet" media="screen" href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,700">
		<link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
		<link rel="stylesheet" href="{{ asset('assets/css/bootstrap-theme.css') }}" media="screen">
		<link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">

	{% endblock %}
</head>

{% block navigation %}  
	{% include 'menu/menu.html.twig'%}
{% endblock %}

<body>

	<!-- Header -->

	<!-- /Body -->

	{% block body %} {% endblock %}


	

	<!-- JavaScript libs are placed at the end of the document so the pages load faster -->
{% block javascripts %}
	<script src="http://ajax.googleapis.com/ajax/libs/jquery/1.10.2/jquery.min.js"></script>
	<script src="http://netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>

	<script src="{{asset('assets/js/headroom.min.js')}}"></script>
	<script src="{{asset('assets/js/jQuery.headroom.min.js')}}"></script>
	<script src="{{asset('assets/js/template.js')}}"></script>
{% endblock %}
</body>
</html>