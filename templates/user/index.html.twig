{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Utillisateurs {% endblock %}


{% block navigation %}  
    {% include 'menu/menu.html.twig'%}
{% endblock %}

{% block brand %}   
	{{ parent() }} users
    <hr style="width:100%; height:1px; background-color:#1B4F72 ">
{% endblock %}


{% block body %}
<!-- container -->

    <div class="container">

        <div class="example-wrapper">
            <h4>Les Utilisateurs</h4> 
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Noms</th>
                        <th>Prenoms</th>
                        <th>Age</th>
                        <th>Adresse</th>
                        <th>Telephone</th>
                        <th>Emails</th>
                        <th>Login</th>
                    </tr>
                </thead>
            <tbody>
                {% for utilisateur in utilisateurs %}
                <tr>
                    <td>{{ utilisateur.id }}</td>
                    <td>{{ utilisateur.noms}}</td>
                    <td>{{ utilisateur.prenoms }}</td>
                    <td>{{ utilisateur.datenaissance | date("d/m/Y")}}</td>
                    <td>{{ utilisateur.adresse}}</td>
                    <td>{{ utilisateur.telephone}}</td>
                    <td>{{ utilisateur.mail}}</td>
                    <td>{{ utilisateur.login}}</td>
                    <br>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4">Pas d'enregistrement</td>
                </tr>
                {% endfor %}
            </tbody>
    </table>
    </div>
    </div>
{% endblock %}


