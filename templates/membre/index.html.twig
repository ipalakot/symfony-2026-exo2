{% extends 'base2.html.twig' %}

{% block title %}{{ parent() }} Membre{% endblock %}

{% block navigation %}  
    {% include 'menu/menu2.html.twig'%}
{% endblock %}


{% block brand %}   
	{{ parent() }} membres
    <hr style="width:100%; height:1px; background-color:#1B4F72 ">
{% endblock %}


{% block body %}

<!-- container -->
    <div class="container">

        <div class="example-wrapper">

        {# Boucle For sur la list edes Etudiants du Controller MembreController #}
        <h5> <u> Liste des étudinats 2 </u> </h5>
            
            <table>
                <tr>
                    <th> Noms </th>
                    <th> - Prennoms </th>
                </tr>
                {% for etudiant in etudiants %}      
                    <tr>
                        <td> {{ etudiant.nom }} </td>
                        <td> - {{ etudiant.prenom }} </td> 
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2">Aucun étudiant trouvé.</td>
                    </tr>
                    {% endfor %}
            </table>

        </div>
    </div>




{% endblock %}
